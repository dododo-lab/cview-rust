diff --git a/src/utils/live-sync-reference.ts b/src/utils/live-sync-reference.ts
new file mode 100644
index 0000000..9a2fc2b
--- /dev/null
+++ b/src/utils/live-sync-reference.ts
@@ -0,0 +1,29 @@
+// CView 수정(0001): 라이브 기준 단위. Apache-2.0 §4(b) — 이 파일은 CView 가 추가했다.
+//
+// hls.js 는 지연 목표·liveSyncPosition 상한·정지 후 증가 상한·갱신 지연 판정·최대 지연을 모두
+// EXT-X-TARGETDURATION 의 배수로 계산한다. 치지직처럼 실제 세그먼트(2초)보다 TARGETDURATION(10초)을
+// 크게 선언하는 스트림에서는 라이브 기준이 5배 뒤로 밀린다(시작 지연 10초, 기본 목표 30초).
+// `liveSyncReference: 'segment'` 이면 그 단위를 실제 평균 세그먼트 길이로 바꾼다. 기본값
+// 'targetduration' 은 업스트림과 같다.
+import type { LevelDetails } from '../loader/level-details';
+
+export type LiveSyncReference = 'targetduration' | 'segment';
+
+/** 세그먼트 기준에서도 이보다 짧게 잡지 않는다(비정상적으로 짧은 재생목록 방어). */
+const MIN_SEGMENT_SYNC_UNIT = 0.5;
+
+export function liveSyncUnit(
+  details: LevelDetails,
+  config: { liveSyncReference?: LiveSyncReference },
+): number {
+  const targetduration = details.targetduration;
+  if (config.liveSyncReference !== 'segment') {
+    return targetduration;
+  }
+  const average = details.averagetargetduration;
+  if (!average || !Number.isFinite(average) || average <= 0) {
+    return targetduration;
+  }
+  const unit = Math.max(average, MIN_SEGMENT_SYNC_UNIT);
+  return targetduration > 0 ? Math.min(targetduration, unit) : unit;
+}
