+/**
+ * CView 수정(0006): 두 코덱 묶음(`avc1,mp4a` 와 `hvc1,mp4a` 같은 레벨의 codecSet)이 영상 코덱만 다른가.
+ * 둘 다 영상 코덱이 있고, 영상이 아닌 코덱(오디오 등)은 순서까지 같아야 한다.
+ */
+export function isVideoCodecFamilySwitch(a: string, b: string): boolean {
+  const split = (set: string) => {
+    const codecs = set.split(',');
+    return {
+      video: codecs.filter((c) => isCodecType(c, 'video')),
+      rest: codecs.filter((c) => !isCodecType(c, 'video')).join(','),
+    };
+  };
+  const x = split(a);
+  const y = split(b);
+  return x.video.length > 0 && y.video.length > 0 && x.rest === y.rest;
+}
