{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CView",
  "version": "0.1.0",
  "identifier": "app.cview.rust",
  "build": {
    "frontendDist": "../../app-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CView",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 660,
        "backgroundColor": "#0f1012",
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "cview"
        ]
      }
    }
  }
}
