{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CView",
  "version": "0.1.21",
  "identifier": "app.cview.rust",
  "build": {
    "frontendDist": "../../app-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CView",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 660,
        "backgroundColor": "#0f1012",
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob: cvimg: http://cvimg.localhost; media-src 'self' blob: https: http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* https:; worker-src 'self' blob:; frame-src 'self' https:; font-src 'self' data:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "public.app-category.entertainment",
    "shortDescription": "치지직 라이브 데스크톱 뷰어",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "bundleVersion": "21",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "signingIdentity": "Developer ID Application: Kim Sun Dong (MZ8NB937SB)",
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "cview"
        ]
      }
    }
  }
}
