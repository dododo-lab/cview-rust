{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CView",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 660,
        "backgroundColor": "#0f1012",
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "publisher": "CView",
    "copyright": "CView",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
